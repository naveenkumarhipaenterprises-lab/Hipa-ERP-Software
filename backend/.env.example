# HIPA MASALA backend settings. Copy to .env and fill in real values. Never commit .env.

# --- Django (required) ---
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Supabase (required) ---
# Database: Supabase dashboard -> Connect -> "Session pooler" URI, with your database password filled in. Shape:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
# Project API: Supabase dashboard -> Project Settings -> API (for Supabase services such as Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Used in password-reset and invitation links
FRONTEND_URL=http://localhost:5173

# --- Optional ---
# TIME_ZONE=Asia/Kolkata
# JWT_ACCESS_MINUTES=480
# JWT_REFRESH_DAYS=7
# LOGIN_THROTTLE_RATE=10/min
# AI_CHAT_THROTTLE_RATE=20/min
# Only when Django runs behind a reverse proxy (nginx, a load balancer): how many. Leave unset otherwise.
# NUM_PROXIES=1   (on Vercel it defaults to 1)
# Postgres driver on Windows: defaults to python (PostgreSQL's libpq.dll) when PostgreSQL is installed; binary to opt out
# PSYCOPG_IMPL=python
# LOG_LEVEL=INFO

# Backups (Settings -> Data & Backup)
# pg_dump must be the same major version as the Supabase server, or newer
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# BACKUP_DIR=D:\HipaBackups

# E-mail (password resets, invitations, customer offers). Console backend prints e-mails to the server log.
# Gmail: turn on 2-Step Verification, create an App password (Google Account > Security > App passwords)
# and use it as EMAIL_HOST_PASSWORD; the normal Gmail password is refused. Gmail sends about 500 e-mails a day.
# Test with: python manage.py sendtestemail you@example.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_TIMEOUT=20
# DEFAULT_FROM_EMAIL=HIPA MASALA <no-reply@example.com>

# AI Assistant chat: Google Gemini (free tier). Leave the key empty to show "not connected".
# Get a key at https://aistudio.google.com/apikey . It stays on the server; never put it in the frontend.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_SECONDS=60

# Production only
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
